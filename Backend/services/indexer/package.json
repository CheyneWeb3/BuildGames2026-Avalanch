{
  "name": "@hauscashier/indexer",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/abi && cp -f src/abi/*.json dist/abi/",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no-lint'"
  },
  "dependencies": {
    "@hauscashier/common": "*",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.5",
    "node-fetch": "^3.3.2",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}

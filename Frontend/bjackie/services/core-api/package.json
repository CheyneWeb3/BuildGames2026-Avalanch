{
  "name": "@yeticashier/core-api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "npm -w @yeticashier/module-dice run build && npm -w @yeticashier/module-lottery run build && npm -w @yeticashier/module-whack run build && npm -w @yeticashier/module-blackjack run build && tsc -p tsconfig.json",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no-lint'"
  },
  "dependencies": {
    "@yeticashier/common": "*",
    "@yeticashier/module-dice": "*",
    "@yeticashier/module-lottery": "file:../../modules/lottery",
    "@yeticashier/module-whack": "file:../../modules/whack",
    "@yeticashier/module-blackjack": "file:../../modules/blackjack",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0",
    "pino": "^9.3.2",
    "pino-http": "^10.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
